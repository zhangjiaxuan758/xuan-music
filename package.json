{
  "name": "xuan-music",
  "productName": "小轩音乐",
  "description": "小轩音乐 - Android 网易云音乐第三方客户端",
  "author": "zhangjiaxuan758",
  "private": true,
  "version": "1.6.5",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:vercel-api && vite build",
    "build:capacitor": "cross-env FOLIA_BUILD_TARGET=capacitor vite build",
    "build:vercel-api": "tsc -p api-ts/tsconfig.json",
    "preview": "vite preview",
    "cap:sync:android": "npm run build:capacitor && cap sync android",
    "cap:assets:android": "node scripts/generate-android-assets.mjs",
    "cap:open:android": "cap open android",
    "cap:run:android": "npm run build:capacitor && cap run android",
    "build:android:debug": "npm run cap:sync:android && cd android && gradlew.bat assembleDebug",
    "build:android:bundle": "npm run cap:sync:android && cd android && gradlew.bat bundleRelease",
    "typecheck": "tsc --noEmit",
    "android:release": "npm run build:capacitor && npx cap sync android"
  },
  "dependencies": {
    "@applemusic-like-lyrics/ttml": "^1.0.1",
    "@capacitor/android": "8.4.2",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.4.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@chenglou/pretext": "^0.0.8",
    "@google/genai": "^2.12.0",
    "@neteasecloudmusicapienhanced/api": "^4.36.2",
    "@paper-design/shaders-react": "^0.0.77",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@xhayper/discord-rpc": "^1.3.4",
    "@xmldom/xmldom": "^0.9.10",
    "axios": "^1.18.1",
    "blueimp-md5": "^2.19.0",
    "buffer": "^6.0.3",
    "busboy": "^1.6.0",
    "dexie": "^4.4.4",
    "fflate": "^0.8.3",
    "framer-motion": "^12.42.2",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "kugoumusicapi": "https://github.com/MakcRe/KuGouMusicApi/archive/refs/tags/v1.5.1.tar.gz",
    "lucide-react": "^1.25.0",
    "music-metadata": "^11.14.0",
    "opencc-js": "^1.4.1",
    "react": "^19.2.7",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "react-window": "^2.2.7",
    "three": "^0.185.1",
    "twgl.js": "^7.0.0",
    "wanakana": "^5.3.1",
    "ws": "^8.21.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.4.2",
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/blueimp-md5": "^2.18.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "baseline-browser-mapping": "^2.10.43",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "@discordjs/rest": {
      "undici": "^6.27.0"
    }
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
