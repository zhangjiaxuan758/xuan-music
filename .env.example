# 小轩音乐 配置示例
# 复制为 .env.local 后填入你自己的值；真实值请勿提交到公开仓库。
VITE_APP_NAME=小轩音乐

# 本版直连网易云官方 music.163.com，无需任何第三方音源后端地址。
VITE_NETEASE_API_BASE=
VITE_KUGOU_API_BASE=
VITE_FOLIA_API_BASE=

# 网易云 eapi 协议常量（见 src/services/netease.ts，需自行填入）
NETEASE_EAPI_KEY=__PLACEHOLDER_NETEASE_EAPI_KEY__
NETEASE_EAPI_SALT=__PLACEHOLDER_NETEASE_EAPI_SALT__
